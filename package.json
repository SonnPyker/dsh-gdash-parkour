{
  "name": "dsh-gdash-parkour",
  "version": "1.2.7",
  "description": "Geometry Dash Parkour for DSH — điều khiển ô vuông nhảy trên các dòng chat, collider từ UI, giãn dòng + kéo box + particles",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "cordis",
    "geometry-dash",
    "parkour",
    "plugin"
  ],
  "scripts": {
    "build": "echo \"no build step - lib/client.js is plain JS\"",
    "watch": "echo \"edit lib/client.js directly\""
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "lib/",
    "client/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
